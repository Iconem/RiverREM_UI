# Domain Traefik routes to this app (must match your DNS + Traefik entrypoint).
DOMAIN=rem.example.com

# Public origin the browser uses to reach the backend. COG URLs returned by the API
# and the shareable permalinks are built from this — set it to your https domain.
PUBLIC_BASE=https://rem.example.com

# Frontend -> API base. Leave EMPTY: the nginx `web` container proxies the API on the
# same origin. Only set this if you split the API onto a different host.
VITE_API_BASE=

# Max number of stored REM job dirs before oldest are evicted (bounds disk use).
MAX_COGS=200

# Short git commit hash shown in the footer (optional).
GIT_SHA=dev
