# Normalize all text files to LF in the repo; let Git handle the working-tree EOL.
# After adding this file, run once:  git add --renormalize .
* text=auto eol=lf

# Explicit text types (so they always normalize regardless of content sniffing)
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.py    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.txt   text eol=lf
*.conf  text eol=lf
Dockerfile text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary assets — never touch their bytes
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary
*.tif   binary
*.tiff  binary
*.zip   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
